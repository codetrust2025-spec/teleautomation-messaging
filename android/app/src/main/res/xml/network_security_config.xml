<?xml version="1.0" encoding="utf-8"?>
<!--
    Transport-security policy (R23.2).

    base-config: cleartext is DENIED globally. Every Backend request therefore has
    to use https/wss in release builds; any accidental http/ws downgrade fails fast.

    domain-config: cleartext is PERMITTED only for explicitly enumerated development
    hosts (Android emulator loopback 10.0.2.2, on-device loopback 127.0.0.1, and
    localhost). These cover local FastAPI development against http://10.0.2.2:PORT
    and are the sole exceptions to the https/wss requirement.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Development-only cleartext allowlist. Do not add production hosts here. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
