# Production reverse proxy for the split.
#
# Three hostnames, three server blocks, one purpose each:
#   teleautomation.online             -> static entry page only
#   marketing.teleautomation.online   -> Marketing service
#   operations.teleautomation.online  -> Operations service
#
# The root block serves files, and proxies an application only through narrow,
# explicitly listed locations - never a broad prefix and never /api/. Routing
# both origins wholesale through one hostname is how the monolith's coupling
# would creep back.
#
# The listed exceptions are all unauthenticated by nature: provider callbacks
# that are still registered against the apex, and the public submit-slot page
# candidates are given apex links to. None of them sets a session cookie, which
# is why the cookie-scope separation below still holds. Keep it that way: the
# moment an authenticated route is proxied here, the two services share a
# cookie scope.
#
# Cookies are scoped per hostname. Marketing and Operations issue their own
# session cookies on their own subdomains, so neither can read the other's.
# Nothing here sets a cookie Domain, which would widen that scope to the parent
# and undo the separation.
#
# Prepared, NOT installed. Applying this replaces how teleautomation.online is
# served and is a production cutover action requiring explicit authorisation.
#
# $connection_upgrade comes from conf.d/ws_upgrade.conf, which already exists on
# the host. Without the Upgrade/Connection headers below nginx silently drops
# WebSocket upgrades, and the failure only shows once a proxy is in front.

# ---------------------------------------------------------------------------
# Root: entry page
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name teleautomation.online www.teleautomation.online;

    ssl_certificate     /etc/letsencrypt/live/teleautomation.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/teleautomation.online/privkey.pem;

    root /srv/teleautomation-landing;
    index index.html;

    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Links already sent to real people point at the apex. Without these, every
    # previously issued join link and booking link 404s the moment the apex
    # stops proxying the application. Narrow prefixes only - this is a redirect,
    # not a proxy, so the apex still does not recombine the two services.
    # Provider-held callbacks still registered against the apex. A provider does
    # not reliably follow a 301 on a POST, and a dropped webhook is a message
    # nobody ever learns was sent - so these are proxied to the owning service
    # until each provider is re-registered against its subdomain. Narrow exact
    # prefixes only; the apex still serves a static page for everything else.
    # PERMANENT. The internal service API is never public on any hostname.
    # Without this the apex answers /internal/ with 200 and the landing page:
    # no data is exposed while root is a static file, but this vhost also
    # proxies provider callbacks, so a 200 here becomes a real hole the moment
    # anyone widens one of those locations. Do not remove with temporary
    # cutover scaffolding - it was lost that way once already.
    location ^~ /internal/ { return 404; }

    location ^~ /webhooks/whatsapp {
        proxy_pass http://127.0.0.1:8110;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /api/candidate-mailboxes/oauth/google/ {
        proxy_pass http://127.0.0.1:8210;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /api/gmail/pubsub/ {
        # The Pub/Sub verification token travels in the query string, so
        # logging this route writes a live shared secret to disk.
        access_log off;
        proxy_pass http://127.0.0.1:8210;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ^~ /call/join/   { return 301 https://marketing.teleautomation.online$request_uri; }
    location ^~ /voice/join/  { return 301 https://marketing.teleautomation.online$request_uri; }
    # submit-slot is served ON the apex, not redirected away from it. Candidates
    # are given apex links; a 301 breaks the flow the moment one is opened from
    # a client that does not follow redirects on POST. Scoped deliberately: the
    # SPA entry point and only the paths it needs. /api/ is NOT proxied here.
    location = /submit-slot  { proxy_pass http://127.0.0.1:8210; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
    location = /submit-slot/ { proxy_pass http://127.0.0.1:8210; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
    location ^~ /assets/     { proxy_pass http://127.0.0.1:8210; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
    location ^~ /public/     { client_max_body_size 50m; proxy_pass http://127.0.0.1:8210; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }
    # /bookings/confirm is the only public booking-creation boundary. Without
    # this the page loads on the apex but the final "Confirm booking" POST 404s
    # into the static landing page.
    location ^~ /bookings/   { client_max_body_size 50m; proxy_pass http://127.0.0.1:8210; proxy_http_version 1.1; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; proxy_set_header X-Forwarded-Proto $scheme; }

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Certbot renewal must keep working from the root host.
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
}

server {
    listen 80;
    server_name teleautomation.online www.teleautomation.online;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

# ---------------------------------------------------------------------------
# Marketing
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name marketing.teleautomation.online;

    ssl_certificate     /etc/letsencrypt/live/marketing.teleautomation.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/marketing.teleautomation.online/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 25m;   # group-list and media uploads

    # Internal service routes are for the peer service over the private network,
    # never for the public internet. The application also rejects them without a
    # token; this is defence in depth, not the only control.
    location ^~ /internal/ { return 404; }

    location / {
        proxy_pass http://127.0.0.1:8110;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
}

server {
    listen 80;
    server_name marketing.teleautomation.online;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
server {
    listen 443 ssl http2;
    server_name operations.teleautomation.online;

    ssl_certificate     /etc/letsencrypt/live/marketing.teleautomation.online/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/marketing.teleautomation.online/privkey.pem;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Payment proofs, resumes and Data Room documents.
    client_max_body_size 50m;

    location ^~ /internal/ { return 404; }

    # Google Pub/Sub pushes Gmail notifications here. It is a machine-to-machine
    # caller holding no dashboard session, so it is deliberately unauthenticated
    # at this layer - the endpoint itself compares
    # GMAIL_PUBSUB_VERIFICATION_TOKEN with hmac.compare_digest before touching a
    # mailbox, which is the actual authentication. Exact match, so no sibling
    # API path is opened up.
    location = /api/gmail/pubsub/push {
        # The verification token travels in the query string (Pub/Sub push
        # cannot send custom headers), so logging this route would write a live
        # shared secret to disk on every push and into any backup that follows.
        # The application logs the delivery itself, so nothing is lost.
        access_log off;
        proxy_pass http://127.0.0.1:8210;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8210;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        $connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
}

server {
    listen 80;
    server_name operations.teleautomation.online;
    location ^~ /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}
