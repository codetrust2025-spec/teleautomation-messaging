# Staging TLS termination for the two split services.
#
# Caddy obtains and renews Let's Encrypt certificates automatically and redirects
# HTTP to HTTPS by default, so neither needs configuring here.
#
# reverse_proxy passes Connection and Upgrade through unchanged, so WebSocket
# upgrades work without an explicit rule. That is worth stating because the
# equivalent nginx configuration does NOT: nginx silently drops the upgrade
# headers unless proxy_set_header Upgrade/Connection are set, and the symptom is
# a WebSocket that fails only in the hosted environment.

{
	# Falls back to Caddy's internal default when ACME_EMAIL is unset.
	email {$ACME_EMAIL}
}

# Site addresses are overridable so CI can exercise this exact file over plain
# HTTP. Automatic certificates need a public IP that CI does not have, but the
# reverse_proxy and WebSocket blocks below are the parts that actually break,
# and those are worth testing against the real config rather than a copy.
{$MARKETING_SITE:marketing.{$STAGING_IP}.sslip.io} {
	encode gzip

	# Long-lived sockets must not be cut short by the default write timeout.
	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy marketing-api:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy marketing-api:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	log {
		output stdout
		format console
	}
}

{$OPERATIONS_SITE:operations.{$STAGING_IP}.sslip.io} {
	encode gzip

	@websocket {
		header Connection *Upgrade*
		header Upgrade websocket
	}
	handle @websocket {
		reverse_proxy operations-api:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy operations-api:8000 {
			header_up X-Forwarded-Proto https
		}
	}

	log {
		output stdout
		format console
	}
}
